Name      ALU-mux;
Partno    ALU-mux;
Date      2024;
Revision  00;
Designer  Tim;
Company   Tim;
Assembly  None;
Location  None;
Device    g16v8a; /* target:ATF16V8B */

/*
    4 x 2-to-1 multiplexor (mux), with zero-out flag (Z).
    Similar to 74'157 (but different pinout, and Z).

    Device pins: ATF16V8B:
        Vcc:   20
        GND:   10
        i/clk: 01
        i:     02 .. 09
        i//OE: 11
        i/o:   12 .. 19
*/

/* Input */
PIN [ 4.. 1] = [A0..3];
PIN [ 8.. 5] = [B0..3];
PIN 9        = select;   // ? Y=B : Y=A

/* Output */
PIN [13..16] = [Y0..3];
PIN 18       = Z;        // zero

/* Logic */

[Y0..3] =
    select:0 & ([A0..3]) #
    select:1 & ([B0..3]) ;

Z =
    select:0 & !([A0..3]:#) #
    select:1 & !([B0..3]:#) ;
